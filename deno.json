{
  "name": "@canac/bundle-blame",
  "version": "0.2.0",
  "license": "MIT",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-env --allow-read --allow-write --allow-run --watch src/main.ts"
  },
  "imports": {
    "@david/dax": "jsr:@david/dax@^0.43",
    "@optique/core": "jsr:@optique/core@^1.3.6",
    "@optique/run": "jsr:@optique/run@^1.3.6",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/collections": "jsr:@std/collections@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/fmt": "jsr:@std/fmt@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": {
    "lineWidth": 100
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*_test.ts"
    ]
  },
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  }
}
